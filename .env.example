# ─────────────────────────────────────────────────────────────────────────────
# mehrdad.ir — environment template
# Copy to `.env` (local dev) and set the same vars in cPanel for production.
# NEVER commit the real .env — this repo is public.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──
# Local development: plain SQLite file.
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Production (cPanel): remote Turso cloud DB — when TURSO_DATABASE_URL is set,
# src/lib/db.ts automatically switches from SQLite to the libsql driver
# adapter and DATABASE_URL is ignored. The admin session/HMAC code has no
# dependency on which mode is active.
# TURSO_DATABASE_URL=libsql://mehrdad-goolro.aws-ap-south-1.turso.io
# TURSO_AUTH_TOKEN=<db-jwt-from-turso>       # rotate periodically

# ── Admin panel ──
# REQUIRED for the admin dashboard (fail-closed if missing → 503).
# Use a long random string; changing it also instantly invalidates all
# issued admin sessions (the session cookie is HMAC-signed with it).
# ADMIN_PASSWORD=<long-random-secret>

# ── Debug ──
# 1 = also log every Prisma query (privacy: can leak request payloads into
# stdout/logs — leave unset in production)
# PRISMA_DEBUG=1
