{
  "name": "mehrdad-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bash -o pipefail -c 'PREVIEW_EMBED=1 next dev -p 3000 2>&1 | tee dev.log'",
    "build": "prisma generate && next build && node scripts/postbuild.mjs",
    "start": "NODE_ENV=production node .next/standalone/server.js",
    "lint": "eslint .",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "agency:build": "node scripts/build-agency-library.mjs"
  },
